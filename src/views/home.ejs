<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chattr</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container-fluid vh-100 p-0">

        <div class="row h-100 g-0">

            <!-- Sidebar -->
            <div class="col-4 col-md-3 border-end">

                <!-- Sidebar Header -->
                <div class="p-3 d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">Chatly</h3>

                    <!-- Profile Dropdown -->
                    <div class="dropdown">

                        <button class="btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                            <i class="bi bi-person-circle fs-4"></i>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item" href="/chat/profile">
                                    <i class="bi bi-person me-2"></i>
                                    Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <form id="logoutForm" action="/logout" method="POST">

                                    <button type="submit" class="dropdown-item">

                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Logout

                                    </button>

                                </form>
                            </li>

                        </ul>

                    </div>

                </div>


                <!-- Search -->
                <div class="px-3">

                    <input 
                        type="text" 
                        id="searchInput" 
                        class="form-control" 
                        placeholder="Search chats..."
                    >
                    
                    <div id="searchResults" class="mt-2"></div>

                </div>


                <!-- Users -->
                <div id ="chatUsersContainer" class="mt-3">

                    <% users.forEach(user=> { %>

                        <div class="p-3 border-bottom chat-user" data-user-id="<%= user._id %>" data-conversation-id="<%= user.conversationId %>">

                            <strong>
                                <%= user.name %>
                            </strong>

                            <% if (user.unreadCount> 0) { %>
                                <span class="unread-badge">
                                    <%= user.unreadCount %>
                                </span>
                                <% } %>

                        </div>

                        <% }) %>

                </div>

            </div>

            <!-- Chat Area -->
            <div class="col-8 col-md-9 d-flex flex-column vh-100">
            
                <!-- Empty State -->
                <div id="emptyChat" class="flex-grow-1 d-flex justify-content-center align-items-center">
            
                    <div class="text-center text-muted">
            
                        <i class="bi bi-chat-dots display-1"></i>
            
                        <h4 class="mt-3">
                            Select a chat
                        </h4>
            
                        <p>
                            Select a user from the left to start chatting.
                        </p>
            
                    </div>
            
                </div>
            
            
                <!-- Actual Chat -->
                <div id="chatArea" class="d-none flex-column h-100">
            
                    <!-- Chat Header -->
                    <div class="p-3 border-bottom">
            
                        <strong id="chatName"></strong>
            
                        <small id="chatPresence" class="d-block text-muted">
                            ○ Offline
                        </small>
            
                    </div>
            
            
                    <!-- Messages -->
                    <div id="messages" class="flex-grow-1 p-3 ">
            
                    </div>
            
            
                    <!-- Message Input -->
                    <div class="p-3 border-top">
                    
                        <!-- Image Preview -->
                        <div id="imagePreviewContainer" class="mb-2 d-none">
                            <img id="imagePreview" src="" alt="Selected image preview" class="img-thumbnail"
                                style="max-width: 120px; max-height: 120px;">
                    
                            <button type="button" id="removeImageButton" class="btn btn-sm btn-outline-danger ms-2">
                                <i class="bi bi-x-lg"></i> Remove
                            </button>
                        </div>
                    
                        <div class="input-group">
                    
                            <!-- Select Image -->
                            <button type="button" id="imageButton" class="btn btn-light border" title="Send an image">
                                <i class="bi bi-image fs-5"></i>
                            </button>
                    
                            <input type="file" id="imageInput" accept="image/*" hidden>
                    
                            <!-- Text Message -->
                            <input type="text" id="messageInput" class="form-control" placeholder="Type a message...">
                    
                            <!-- Send Message -->
                            <button id="sendButton" class="btn btn-primary">
                                <i class="bi bi-send-fill"></i>
                            </button>
                    
                        </div>
                    </div>
            
                </div>
            
            </div>

        </div>

    </div>

    <!-- Enlarge Image Modal -->
    <div id="imageModal" class="image-modal d-none">
        <button id="closeImageModal" class="close-image-modal" type="button">
            &times;
        </button>
    
        <img id="enlargedImage" src="" alt="Enlarged shared image">
    </div>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Socket.IO -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Chat JavaScript -->
    <script src="/js/chat.js"></script>

</body>

</html>
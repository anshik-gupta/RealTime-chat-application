<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Real-Time Chat</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container-fluid vh-100 p-0">

        <div class="row h-100 g-0">

            <!-- Sidebar -->
            <div class="col-4 col-md-3 border-end">

                <!-- Sidebar Header -->
                <div class="p-3 d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">Chatly</h3>

                    <!-- Profile Dropdown -->
                    <div class="dropdown">

                        <button class="btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                            <i class="bi bi-person-circle fs-4"></i>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item" href="/chat/profile">
                                    <i class="bi bi-person me-2"></i>
                                    Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <form action="/logout" method="POST">

                                    <button type="submit" class="dropdown-item">

                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Logout

                                    </button>

                                </form>
                            </li>

                        </ul>

                    </div>

                </div>


                <!-- Search -->
                <div class="px-3">

                    <input type="text" class="form-control" placeholder="Search chats...">

                </div>


                <!-- Users -->
                <div class="mt-3">

                    <% users.forEach(user=> { %>

                        <div class="p-3 border-bottom chat-user" data-user-id="<%= user._id %>">

                            <strong>
                                <%= user.username %>
                            </strong>

                        </div>

                        <% }) %>

                </div>

            </div>

            <!-- Chat Area -->
            <div class="col-8 col-md-9 d-flex flex-column vh-100">
            
                <!-- Empty State -->
                <div id="emptyChat" class="flex-grow-1 d-flex justify-content-center align-items-center">
            
                    <div class="text-center text-muted">
            
                        <i class="bi bi-chat-dots display-1"></i>
            
                        <h4 class="mt-3">
                            Select a chat
                        </h4>
            
                        <p>
                            Select a user from the left to start chatting.
                        </p>
            
                    </div>
            
                </div>
            
            
                <!-- Actual Chat -->
                <div id="chatArea" class="d-none flex-column h-100">
            
                    <!-- Chat Header -->
                    <div class="p-3 border-bottom">
            
                        <strong id="chatUsername"></strong>
            
                        <small class="d-block text-success">
                            ● Online
                        </small>
            
                    </div>
            
            
                    <!-- Messages -->
                    <div id="messages" class="flex-grow-1 p-3 ">
            
                    </div>
            
            
                    <!-- Message Input -->
                    <div class="p-3 border-top">
            
                        <div class="input-group">
            
                            <input type="text" id="messageInput" class="form-control" placeholder="Type a message...">
            
                            <button id="sendButton" class="btn btn-primary">
            
                                <i class="bi bi-send-fill"></i>
            
                            </button>
            
                        </div>
            
                    </div>
            
                </div>
            
            </div>

        </div>

    </div>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Socket.IO -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Chat JavaScript -->
    <script src="/js/chat.js"></script>

</body>

</html>